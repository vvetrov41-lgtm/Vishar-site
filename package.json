{
  "name": "vishar-site",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "optimize:images": "node scripts/optimize-images.mjs",
    "thumbs:portfolio": "node scripts/generate-portfolio-thumbs.mjs",
    "thumbs:galleries": "node scripts/generate-gallery-thumbs.mjs",
    "build:tailwind": "tailwindcss -i ./assets/css/input.css -o ./assets/css/tailwind.css --minify",
    "validate:site": "node scripts/validate-site.mjs",
    "validate:calendar-staging": "node scripts/validate-calendar-staging.mjs",
    "validate:calendar-staging:deploy-ready": "node scripts/validate-calendar-staging.mjs --deploy-ready",
    "validate:gpt-actions": "node scripts/validate-gpt-actions.mjs",
    "test:booking": "node scripts/test-booking-flow.mjs",
    "test:db": "bash scripts/run-crm-db-tests.sh",
    "test:worker": "node scripts/test-worker-modules.mjs && node scripts/test-calendar-worker.mjs && node scripts/test-calendar-scheduler.mjs && node scripts/test-calendar-oauth-hardening.mjs && node scripts/test-calendar-metadata-rpc.mjs && node scripts/test-gpt-actions.mjs && node scripts/test-gpt-actions-entrypoint.mjs && node scripts/validate-gpt-actions.mjs",
    "check:worker-bundle": "XDG_CONFIG_HOME=.wrangler/config WRANGLER_LOG_PATH=.wrangler/wrangler.log WRANGLER_SEND_METRICS=false wrangler deploy --env=\"\" --dry-run --outdir .wrangler/dry-run",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "vendor:3d-libs": "node scripts/vendor-3d-libs.mjs",
    "vendor:3d-libs:check": "node scripts/vendor-3d-libs.mjs --check",
    "vendor:fonts": "node scripts/vendor-fonts.mjs",
    "vendor:fonts:check": "node scripts/vendor-fonts.mjs --check"
  },
  "devDependencies": {
    "@fontsource/bodoni-moda": "5.2.7",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/inter": "5.2.8",
    "@fontsource/playfair-display": "5.2.8",
    "gsap": "3.12.5",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "three": "0.128.0",
    "wrangler": "4.115.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "undici": "7.29.0"
  }
}
