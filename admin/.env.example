# Copy to .env.local and fill in from your own Supabase project.
# NEVER put SUPABASE_SERVICE_ROLE_KEY here. It is a full-database credential and
# belongs only in a Cloudflare Worker secret. The anon key below is a public
# identifier: it confers no permission on its own, and everything it can do is
# decided by row level security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
