# Copy to .env.local and fill in from your own Supabase project.
# NEVER put a Supabase secret or service-role key here. It is a privileged
# backend credential. The publishable key below is a public identifier: it
# confers no permission on its own, and everything it can do is decided by RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional until the separately reviewed Team admin Worker is deployed.
# Exact endpoint only; never put the Worker's Supabase secret in this file.
VITE_TEAM_INVITE_URL=

# Optional. Leave empty when Calendar connection management is disabled.
# Use only the HTTPS connector root below an owned *.vishartattoo.com hostname.
# Never point a production CRM build at the retained staging connector.
VITE_CALENDAR_CONNECTOR_ORIGIN=
